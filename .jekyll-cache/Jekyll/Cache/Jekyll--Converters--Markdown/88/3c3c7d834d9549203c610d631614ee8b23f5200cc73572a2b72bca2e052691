            <span class="k">print</span><span class="p">(</span><span class="s">'loss value: {}'</span><span class="p">.</span><span class="nb">format</span><span class="p">(</span><span class="n">node</span><span class="p">.</span><span class="n">value</span><span class="p">))</span>


<span class="c1"># Backward Propogation
</span>

<span class="k">def</span> <span class="nf">backward</span><span class="p">(</span><span class="n">graph_sorted_nodes</span><span class="p">):</span>
    <span class="k">for</span> <span class="n">node</span> <span class="ow">in</span> <span class="n">graph_sorted_nodes</span><span class="p">[::</span><span class="o">-</span><span class="mi">1</span><span class="p">]:</span>
