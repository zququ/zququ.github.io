<span class="k">def</span> <span class="nf">forward</span><span class="p">(</span><span class="n">graph_sorted_nodes</span><span class="p">):</span>
    <span class="k">for</span> <span class="n">node</span> <span class="ow">in</span> <span class="n">graph_sorted_nodes</span><span class="p">:</span>
