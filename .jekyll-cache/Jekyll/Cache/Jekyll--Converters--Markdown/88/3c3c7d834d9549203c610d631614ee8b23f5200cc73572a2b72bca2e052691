</span>        <span class="n">node</span><span class="p">.</span><span class="n">backward</span><span class="p">()</span>


<span class="c1"># epoch() = forward() + backward()
</span><span class="k">def</span> <span class="nf">run_one_epoch</span><span class="p">(</span><span class="n">graph_sorted_nodes</span><span class="p">):</span>
    <span class="n">forward</span><span class="p">(</span><span class="n">graph_sorted_nodes</span><span class="p">)</span>
    <span class="n">backward</span><span class="p">(</span><span class="n">graph_sorted_nodes</span><span class="p">)</span>


<span class="k">def</span> <span class="nf">optimize</span><span class="p">(</span><span class="n">graph_nodes</span><span class="p">,</span> <span class="n">learning_rate</span><span class="o">=</span><span class="mf">1e-3</span><span class="p">):</span>
    <span class="k">for</span> <span class="n">node</span> <span class="ow">in</span> <span class="n">graph_nodes</span><span class="p">:</span>
        <span class="k">if</span> <span class="n">node</span><span class="p">.</span><span class="n">is_trainable</span><span class="p">:</span>
            <span class="n">node</span><span class="p">.</span><span class="n">value</span> <span class="o">=</span> <span class="n">node</span><span class="p">.</span><span class="n">value</span> <span class="o">+</span> <span class="p">(</span>
                <span class="o">-</span><span class="mi">1</span><span class="p">)</span> <span class="o">*</span> <span class="n">node</span><span class="p">.</span><span class="n">gradients</span><span class="p">[</span><span class="n">node</span><span class="p">]</span> <span class="o">*</span> <span class="n">learning_rate</span>
            <span class="nb">cmp</span> <span class="o">=</span> <span class="s">'large'</span> <span class="k">if</span> <span class="n">node</span><span class="p">.</span><span class="n">gradients</span><span class="p">[</span><span class="n">node</span><span class="p">]</span> <span class="o">&gt;</span> <span class="mi">0</span> <span class="k">else</span> <span class="s">'small'</span>
