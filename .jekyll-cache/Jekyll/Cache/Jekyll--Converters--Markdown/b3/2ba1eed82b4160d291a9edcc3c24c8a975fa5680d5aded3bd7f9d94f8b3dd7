            <span class="n">node</span> <span class="o">=</span> <span class="n">random</span><span class="p">.</span><span class="n">choice</span><span class="p">(</span><span class="nb">list</span><span class="p">(</span><span class="n">all_nodes_only_have_outputs_no_inputs</span><span class="p">))</span>
