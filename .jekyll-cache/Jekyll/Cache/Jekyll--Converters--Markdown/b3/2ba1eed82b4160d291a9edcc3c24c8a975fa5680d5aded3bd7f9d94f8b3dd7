</span>        <span class="c1"># e.g. simple_graph = {'a': [1, 2], 'b': [2, 3]} # a simple example for graph
</span>        <span class="c1"># reduce(lambda a, b: a + b, list(simple_graph.values())) #通过 reduce 函数将列表加起来
</span>
        <span class="n">all_nodes_have_inputs</span> <span class="o">=</span> <span class="nb">reduce</span><span class="p">(</span><span class="k">lambda</span> <span class="n">a</span><span class="p">,</span> <span class="n">b</span><span class="p">:</span> <span class="n">a</span> <span class="o">+</span> <span class="n">b</span><span class="p">,</span>
