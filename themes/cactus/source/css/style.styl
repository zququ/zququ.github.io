@import "_variables"
@import "_colors/" + $colors
@import "_util"
@import "_mixins"
@import "_extend"
@import "_fonts"

global-reset()

*, *:before, *:after
  box-sizing: border-box

/* Scroll bar */
/* For Firefox */
*
  scrollbar-color: $color-scrollbar transparent

/* For Chrome, Edge, and Safari */
*::-webkit-scrollbar
  width: 8px
  height: 6px

*::-webkit-scrollbar-track
  background: transparent

*::-webkit-scrollbar-thumb
  background-color: $color-scrollbar
  border-radius: 6px

*::-webkit-scrollbar-thumb:hover
  background-color: darken($color-scrollbar, 20%)

*::-webkit-scrollbar-thumb:active
  background-color: darken($color-scrollbar, 30%)

html
  margin: 0
  padding: 0
  height: 100%
  border-top: 2px solid $color-text
  -webkit-text-size-adjust: 100%
  -ms-text-size-adjust: 100%

body
  margin: 0
  height: 100%
  background-color: $color-background
  color: $color-text
  font-weight: 400
  font-size: $font-size
  font-family: $font-family-body
  line-height: $line-height
  text-rendering: geometricPrecision

  antialias()

  @extend $base-style

.content
  position: relative
  display: flex
  flex-direction: column
  min-height: 100%
  overflow-wrap: break-word

  p
    hyphens(auto)

  code
    hyphens(manual)

  a
    color: $color-text
    text-decoration: none

    underline(5px, $color-text)

    &:hover
      background-image: linear-gradient(transparent, transparent 4px, $color-link 4px, $color-link)

  a.icon
    background: none

    &:hover
      color: $color-link

  h1 a, .h1 a, h2 a, h3 a, h4 a, h5 a, h6 a
    background: none
    color: inherit
    text-decoration: none

  h1 a:hover, .h1 a:hover, h2 a:hover, h3 a:hover, h4 a:hover, h5 a:hover, h6 a:hover
    underline(6px, $color-link)

  h6
    a
      background: none
      color: inherit
      text-decoration: none

  h6
    a:hover
      underline(6px, $color-link)

@media (min-width: 540px)
  .image-wrap
    flex-direction: row
    margin-bottom: 2rem

    .image-block
      flex: 1 0 35%
      margin-right: 2rem

    p
      flex: 1 0 65%

.max-width
  max-width: $page-width

@media (max-width: 480px)
  // smaller margins at smaller screen widths
  .px3
    padding-right: 1rem
    padding-left: 1rem

  .my4
    margin-top: 2rem
    margin-bottom: 2rem

@media (min-width: 480px)
  p
    text-align: justify

@import "_partial/header"
@import "_partial/post/actions_desktop"
@import "_partial/post/actions_mobile"
@import "_partial/index"
@import "_partial/article"
@import "_partial/archive"
@import "_partial/comments"
@import "_partial/footer"
@import "_partial/pagination"
@import "_partial/search"
@import "_partial/tags"
@import "_partial/tooltip"
@import "_partial/categories"
// Code
@import "_highlight/" + $highlight

pre
  overflow-x: auto
  padding: 10px 15px
  padding-bottom: 0
  border: 1px dotted $color-border
  border-radius: 4px
  font-size: 13px
  font-family: $font-family-mono
  line-height: 22px
  -webkit-border-radius: 4px

  code
    display: block
    padding: 0
    border: none

code
  padding: 0 5px
  border: 1px dotted $color-border
  border-radius: 2px
  -webkit-border-radius: 2px

.highlight
  overflow-x: auto
  margin: 1rem 0
  padding: 10px 15px
  border-radius: 4px
  background: $color-background-code
  font-family: $font-family-mono
  // color: $color-accent-3
  -webkit-border-radius: 4px

  figcaption
    margin: -5px 0 5px
    color: $color-meta-code
    font-size: .9em
    transform: scale(1)

    a
      float: right
      color: $color-meta-code
      font-style: italic
      font-size: .8em

      underline(10px, $color-link)

    a:hover
      color: lighten($color-meta-code, 20%)

    &:before, content: ""
      display: table

    &:after
      clear: both

  &:hover 
    .btn-copy
      opacity: 1

  .btn-copy
    font-size: 1.2rem
    position: absolute
    right: 20px
    opacity: 0
    transition: opacity 0.2s ease-in
    &:hover
      color: $color-accent-1

  pre
    margin: 0
    padding: 0
    border: none
    background: none

  table
    width: auto

  td.gutter
    text-align: right
    opacity: .2

  .line
    height: 22px

#header-post #actions
  direction: ltr !important

#header.post-page-header
  margin-bottom: 2.5rem

.goyo-toggle
  position: fixed
  top: 2rem
  right: 5.35rem
  z-index: 1000
  padding: 0 .15rem
  width: auto
  height: 1.5rem
  border: 0
  background: transparent
  color: $color-accent-1
  font: 500 .95rem $font-family-mono
  letter-spacing: .01em
  line-height: 1.5rem
  text-align: center
  text-transform: lowercase
  cursor: pointer
  opacity: .82
  transition: opacity .15s ease, color .15s ease

  &:hover
    opacity: 1
    color: $color-link

  &:focus
    outline: none

  &:focus-visible
    color: $color-accent-1
    outline: 1px solid $color-accent-1
    outline-offset: 4px

#reader-note-controls
  position: fixed
  top: 34vh
  left: 1.35rem
  z-index: 1001
  display: flex
  flex-direction: column
  align-items: center
  gap: .35rem
  font-family: $font-family-mono
  pointer-events: auto

  button
    padding: .12rem .18rem
    border: 0
    background: transparent
    color: $color-accent-1
    font: 500 .78rem $font-family-mono
    letter-spacing: .01em
    line-height: 1.1
    writing-mode: vertical-rl
    text-transform: lowercase
    cursor: pointer
    opacity: .68
    transition: opacity .15s ease, color .15s ease, transform .15s ease

    &:hover
      color: $color-link
      opacity: 1

    &:focus
      outline: none

    &:focus-visible
      outline: 1px solid $color-accent-1
      outline-offset: 4px

    &[aria-pressed="true"]
      color: $color-link
      opacity: 1
      transform: translateX(1px)

#reader-note-layer
  position: absolute
  top: 0
  left: 0
  z-index: 920
  width: 100%
  pointer-events: none

.reader-note-bubble
  position: absolute
  width: 15.5rem
  max-width: calc(100vw - 2rem)
  padding: .55rem .7rem .55rem .8rem
  border-left: 2px solid alpha($color-accent-1, .7)
  border-radius: 3px 10px 10px 3px
  background: alpha($color-background, .82)
  box-shadow: 0 10px 30px alpha($color-text, .08)
  color: alpha($color-text, .74)
  font-family: $font-family-body
  font-size: .78rem
  line-height: 1.55
  pointer-events: auto
  backdrop-filter: blur(6px)
  transform: translateY(-50%)
  transition: opacity .18s ease, transform .18s ease, box-shadow .18s ease

  &:hover
    color: $color-text
    box-shadow: 0 14px 38px alpha($color-text, .12)

    .reader-note-delete
      opacity: .65

  &.is-new
    animation: note-drift-in .35s ease both

.reader-note-quote
  margin-bottom: .25rem
  color: alpha($color-accent-1, .88)
  font-family: $font-family-mono
  font-size: .68rem
  line-height: 1.3

.reader-note-text
  white-space: normal

.reader-note-delete
  position: absolute
  top: .2rem
  right: .35rem
  padding: 0
  border: 0
  background: transparent
  color: $color-meta
  font-size: .95rem
  line-height: 1
  cursor: pointer
  opacity: 0
  transition: opacity .15s ease, color .15s ease

  &:hover
    color: $color-link
    opacity: 1

.reader-highlight
  display: inline
  padding: 0
  border-radius: 0
  background: linear-gradient(transparent 48%, alpha($color-accent-1, .24) 48%, alpha($color-accent-1, .24) 92%, transparent 92%)
  color: inherit
  font: inherit
  line-height: inherit
  vertical-align: baseline
  box-decoration-break: clone
  -webkit-box-decoration-break: clone

td .reader-highlight,
th .reader-highlight
  display: inline
  padding: 0
  border-radius: 0
  background: linear-gradient(transparent 52%, alpha($color-accent-1, .22) 52%, alpha($color-accent-1, .22) 90%, transparent 90%)
  font: inherit
  line-height: inherit
  letter-spacing: inherit
  word-spacing: inherit
  white-space: inherit

#reader-note-toolbar
  position: absolute
  z-index: 1100
  display: none
  gap: .15rem
  padding: .22rem .25rem
  border: 1px solid alpha($color-accent-1, .28)
  border-radius: 999px
  background: alpha($color-background, .9)
  box-shadow: 0 12px 32px alpha($color-text, .1)
  backdrop-filter: blur(8px)

  &.is-visible
    display: flex

  button
    padding: .18rem .48rem
    border: 0
    border-radius: 999px
    background: transparent
    color: $color-accent-1
    font: 500 .72rem $font-family-mono
    cursor: pointer

    &:hover
      background: alpha($color-accent-1, .1)
      color: $color-link

#reader-note-composer
  position: fixed
  z-index: 1101
  display: none
  width: 17.5rem
  padding: .55rem
  border: 1px solid alpha($color-accent-1, .32)
  border-radius: 12px
  background: alpha($color-background, .94)
  box-shadow: 0 16px 40px alpha($color-text, .13)
  backdrop-filter: blur(10px)

  &.is-visible
    display: block

  textarea
    display: block
    width: 100%
    min-height: 4.8rem
    padding: .45rem .5rem
    border: 0
    border-radius: 8px
    background: alpha($color-accent-1, .06)
    color: $color-text
    font: .82rem/1.55 $font-family-body
    resize: vertical

    &:focus
      outline: 1px solid alpha($color-accent-1, .36)

.reader-note-composer-actions
  display: flex
  justify-content: flex-end
  gap: .35rem
  margin-top: .45rem

  button
    padding: .16rem .5rem
    border: 0
    border-radius: 999px
    background: transparent
    color: $color-accent-1
    font: .72rem $font-family-mono
    cursor: pointer

    &:hover
      background: alpha($color-accent-1, .1)
      color: $color-link

body.reader-note-mode
  cursor: crosshair

  article.post .content
    cursor: crosshair

  .reader-highlight
    cursor: pointer

    &:hover
      background: linear-gradient(transparent 40%, alpha($color-link, .28) 40%, alpha($color-link, .28) 94%, transparent 94%)

body.reader-notes-hidden
  .reader-highlight
    background: transparent

  #reader-note-layer,
  #reader-note-toolbar,
  #reader-note-composer
    display: none !important

@keyframes note-drift-in
  from
    opacity: 0
    transform: translateY(-50%) translateX(16px)
  to
    opacity: 1
    transform: translateY(-50%) translateX(0)

body.goyo-active
  max-width: none
  padding-right: 0
  padding-left: 0
  border-top: 0
  background: #4b4b4b
  color: #d8d2cc
  font-family: $font-family-mono

  .goyo-toggle
    color: #d9b47c
    opacity: 1

  #reader-note-controls
    button
      color: #d9b47c

      &:hover
        color: #f1c984

  .reader-note-bubble
    border-left-color: #d9b47c
    background: alpha(#424242, .9)
    color: #d8d2cc

  .reader-note-quote
    color: #f1c984

  .reader-highlight
    background: linear-gradient(transparent 48%, alpha(#d9b47c, .28) 48%, alpha(#d9b47c, .28) 92%, transparent 92%)

  #header-post,
  #header.post-page-header,
  #footer-post,
  .article-gallery,
  .meta,
  .article-tag,
  .article-category,
  .comments,
  #comments,
  #disqus_thread,
  #utterances_thread,
  .utterances,
  footer,
  .footer,
  #footer,
  .post + *
    display: none !important

  > .content
    display: block
    max-width: 46rem
    min-height: auto
    margin: 0 auto
    padding: 12vh 2rem 16vh
    background: transparent

  article.post
    margin: 0
    color: #d8d2cc

    header
      margin-bottom: 2.5rem

    .posttitle
      color: #e6bcbc
      font-family: $font-family-mono
      font-size: 1.5rem
      font-weight: 400
      line-height: 1.35
      text-transform: none

      &:after
        display: none
        content: none

    .content
      display: block
      min-height: 0
      color: #d8d2cc
      font-size: 1.02rem
      line-height: 1.95

      p
        text-align: left
        hyphens: manual

      h1,
      h2,
      h3,
      h4,
      h5,
      h6
        color: #e6bcbc
        font-family: $font-family-mono
        font-weight: 400
        letter-spacing: 0
        text-decoration: none

        &:before,
        &:after
          display: none !important
          content: none !important

      h2,
      h3
        padding-bottom: 0
        border-bottom: 0

      hr
        display: none

      a
        color: #f1c984
        background-image: none
        text-decoration: underline
        text-decoration-thickness: 1px
        text-underline-offset: .18em

      strong
        color: #efe4d6
        font-weight: 700

      blockquote
        border-left: 2px solid #8f8774
        color: #c7c0b7

      code
        border-color: #746d63
        background: #424242
        color: #f1c984

      pre,
      .highlight
        border-color: #746d63
        background: #424242

@media (max-width: 720px)
  .goyo-toggle
    top: .75rem
    right: 4.25rem

  #reader-note-controls
    top: auto
    right: 1rem
    bottom: 4.75rem
    left: auto
    flex-direction: row
    gap: .36rem
    padding: .18rem .32rem
    border: 1px solid alpha($color-accent-1, .2)
    border-radius: 999px
    background: alpha($color-background, .86)
    box-shadow: 0 10px 24px alpha($color-text, .08)
    backdrop-filter: blur(8px)

    button
      font-size: .82rem
      line-height: 1.25rem
      writing-mode: horizontal-tb

  .reader-note-bubble
    width: 16rem
    max-width: calc(100vw - 2rem)
    font-size: .74rem

  #reader-note-composer
    width: 17rem
    max-width: calc(100vw - 2rem)

  body.goyo-active
    > .content
      padding: 5rem 1.25rem 6rem

    article.post
      .content
        font-size: .98rem
        line-height: 1.85
